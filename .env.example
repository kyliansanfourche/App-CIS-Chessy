# Copiez ce fichier vers .env et renseignez vos identifiants réels.
# .env n'est jamais commité (voir .gitignore) : c'est le seul endroit où ces valeurs
# doivent exister en clair sur votre machine (ou dans les secrets EAS pour le build cloud).

# Console Firebase > Paramètres du projet > Vos applications > Config SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Tableau de bord EmailJS > Account > API Keys / Email Services / Email Templates
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
